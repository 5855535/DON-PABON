# Número de WhatsApp del negocio: SOLO dígitos con código de país (Colombia = 57).
# Ejemplo con formato (reemplazar por el real): 573001234567
WHATSAPP_PHONE=573XXXXXXXXX

# Supabase → Project Settings → API. Usa SOLO la URL y la clave "anon" (pública).
# NUNCA pongas aquí la clave service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
